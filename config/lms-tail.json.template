{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://127.0.0.1:3000"
        },
        "/assets/": {
          "Proxy": "http://127.0.0.1:5000/assets/"
        },
        "/velxio/": {
          "Proxy": "__VELXIO_PROXY_TARGET__"
        },
        "/editor/": {
          "Proxy": "__VELXIO_PROXY_TARGET__editor/"
        },
        "/editor": {
          "Proxy": "__VELXIO_PROXY_TARGET__editor"
        },
        "/components-metadata.json": {
          "Proxy": "__VELXIO_PROXY_TARGET__components-metadata.json"
        },
        "/component-svgs/": {
          "Proxy": "__VELXIO_PROXY_TARGET__component-svgs/"
        },
        "/wasm/": {
          "Proxy": "__VELXIO_PROXY_TARGET__wasm/"
        },
        "/boards/": {
          "Proxy": "__VELXIO_PROXY_TARGET__boards/"
        },
        "/flowchart/": {
          "Proxy": "http://127.0.0.1:8081/"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }
}
