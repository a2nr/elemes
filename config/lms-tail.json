{
  "TCP": {
    "443": {
      "HTTPS": true
    }
  },
  "Web": {
    "${TS_CERT_DOMAIN}:443": {
      "Handlers": {
        "/": {
          "Proxy": "http://elemes-frontend:3000"
        },
        "/assets/": {
          "Proxy": "http://elemes:5000/assets/"
        },
        "/velxio/api/compile/": {
          "Proxy": "http://elemes:5000/velxio-compile/"
        },
        "/velxio/api/compile": {
          "Proxy": "http://elemes:5000/velxio-compile"
        },
        "/velxio/": {
          "Proxy": "http://velxio:80/"
        },
        "/flowchart/": {
          "Proxy": "http://flowchart:80/"
        }
      }
    }
  },
  "AllowFunnel": {
    "${TS_CERT_DOMAIN}:443": true
  }
}