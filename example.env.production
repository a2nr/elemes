# Production Environment Configuration
#

# tailscale Configuration
ELEMES_HOST=change-to-lms-topic
TS_AUTHKEY=your-super-secret-key-here-change-this-in-production

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# Application Configuration
CONTENT_DIR=content
STATIC_DIR=static
TEMPLATES_DIR=templates
TOKENS_FILE=tokens.csv
APP_BAR_TITLE=Belajar Pemrograman C
COPYRIGHT_TEXT=Sistem Pembelajaran Pemrograman C &copy; 2025
PAGE_TITLE_SUFFIX=Belajar Pemrograman C

# Programming Language Configuration
DEFAULT_PROGRAMMING_LANGUAGE=c
# To use Python as default language instead, uncomment the line below:
# DEFAULT_PROGRAMMING_LANGUAGE=python

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Security Configuration
MAX_CONTENT_LENGTH=1024 * 1024  # 1MB max upload size
WTF_CSRF_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=/var/log/lms-c/app.log

# Database Configuration (if using one in future)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# External Services (if applicable)
# SMTP_SERVER=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=user@example.com
# SMTP_PASSWORD=password
